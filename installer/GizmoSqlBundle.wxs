<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="GizmoSQL Power BI Connector"
           Manufacturer="GizmoData LLC"
           Version="$(var.ProductVersion)"
           UpgradeCode="F7A8B9C0-D1E2-3456-7890-ABCDEF123456"
           Scope="perMachine">

    <Icon Id="gizmosql_odbc.ico" SourceFile="gizmosql_odbc.ico" />
    <Property Id="ARPPRODUCTICON" Value="gizmosql_odbc.ico" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of GizmoSQL Power BI Connector is already installed." />

    <Media Id="1" Cabinet="gizmosql.cab" EmbedCab="yes" />

    <!-- Banner and dialog images -->
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <Feature Id="ProductFeature" Title="GizmoSQL Power BI Connector" Level="1">
      <ComponentGroupRef Id="DriverComponents" />
      <ComponentGroupRef Id="ConnectorComponents" />
      <ComponentGroupRef Id="PowerBITrustComponents" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="GizmoSQL Power BI Connector" />
    </StandardDirectory>
    <!-- Both paths needed: Store version uses "Power BI Desktop",
         standalone installer uses "Microsoft Power BI Desktop" -->
    <StandardDirectory Id="PersonalFolder">
      <Directory Id="PowerBIStoreDir" Name="Power BI Desktop">
        <Directory Id="CustomConnectorsStoreDir" Name="Custom Connectors" />
      </Directory>
      <Directory Id="PowerBIDesktopDir" Name="Microsoft Power BI Desktop">
        <Directory Id="CustomConnectorsDesktopDir" Name="Custom Connectors" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <!-- Apache Arrow Flight SQL ADBC driver. The driver is a Go-built native DLL
       (no VC++ runtime dependency). Adding the install dir to PATH so the
       Power BI mashup container resolves "libadbc_driver_flightsql.dll" by name. -->
  <Fragment>
    <ComponentGroup Id="DriverComponents" Directory="INSTALLFOLDER">
      <Component Id="AdbcFlightSqlDll" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
        <File Id="LibAdbcDriverFlightSqlDll"
              Source="!(bindpath.BinDir)\libadbc_driver_flightsql.dll"
              KeyPath="yes" />
        <Environment Id="AdbcDriverPath"
                     Name="PATH"
                     Action="set"
                     Part="last"
                     System="yes"
                     Value="[INSTALLFOLDER]" />
      </Component>
    </ComponentGroup>

    <!-- Power BI trusted connector registry — allows signed .pqx to load
         at the default "Recommended" security level without user intervention.
         See: https://learn.microsoft.com/en-us/power-bi/connect-data/desktop-trusted-third-party-connectors -->
    <ComponentGroup Id="PowerBITrustComponents" Directory="INSTALLFOLDER">
      <Component Id="PowerBITrustedThumbprint" Guid="1A2B3C4D-5E6F-7890-AB12-CD34EF567890">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Policies\Microsoft\Power BI Desktop">
          <RegistryValue Name="TrustedCertificateThumbprints" Type="multiString"
                         Value="$(var.CertThumbprint)" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <!-- Power BI connector — install to both Store and standalone paths -->
    <ComponentGroup Id="ConnectorComponents">
      <Component Id="ConnectorPqxStore" Guid="E5F6A7B8-C9D0-1234-EFAB-345678901234"
                 Directory="CustomConnectorsStoreDir">
        <File Id="GizmoSqlPqxStore"
              Source="!(bindpath.ConnectorDir)\GizmoSQL.pqx"
              KeyPath="yes" />
      </Component>
      <Component Id="ConnectorPqxDesktop" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
                 Directory="CustomConnectorsDesktopDir">
        <File Id="GizmoSqlPqxDesktop"
              Source="!(bindpath.ConnectorDir)\GizmoSQL.pqx"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
