<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress missing XML doc warnings (CS1591) — docs will be added incrementally -->
    <NoWarn>CS1591</NoWarn>

    <!-- Package metadata -->
    <Authors>GizmoData</Authors>
    <Company>GizmoData</Company>
    <Copyright>Copyright © GizmoData 2025</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/gizmodata/gizmosql-powerbi-connector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gizmodata/gizmosql-powerbi-connector</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
